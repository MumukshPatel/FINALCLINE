{
  "name": "@sap-ai-sdk/orchestration",
  "version": "2.16.0",
  "description": "",
  "keywords": [
    "llm-access",
    "orchestration",
    "sap-ai-sdk"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SAP/ai-sdk-js",
    "directory": "packages/orchestration"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal.js": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "dependencies": {
    "@sap-cloud-sdk/util": "^4.9.1",
    "yaml": "^2.9.0",
    "@sap-ai-sdk/ai-api": "^2.16.0",
    "@sap-ai-sdk/core": "^2.16.0",
    "@sap-ai-sdk/prompt-registry": "^2.16.0"
  },
  "devDependencies": {
    "@sap-cloud-sdk/connectivity": "4.9.1",
    "@sap-cloud-sdk/http-client": "4.9.1",
    "vitest": "5.0.0"
  },
  "scripts": {
    "compile": "tsc",
    "test": "vitest run",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "generate": "openapi-generator --generateESM --clearOutputDir -i ./src/spec/api.yaml -o ./src/client",
    "postgenerate": "rm ./src/client/api/*.ts && pnpm rename-generated-files && pnpm lint:fix",
    "rename-generated-files": "node ../../scripts/postgenerate-orchestration.ts ./src/client/api"
  }
}